# Flask Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key

# Database Configuration
DATABASE_URL=postgresql://printuser:dev_password@localhost:5432/printdb

# Redis Configuration (for background tasks)
REDIS_URL=redis://localhost:6379/0

# Email Server Configuration (Office 365)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@university.edu
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=your_email@university.edu

# File Storage Configuration
STORAGE_BASE_PATH=/app/storage

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# System Configuration
CONFIRMATION_TOKEN_EXPIRES_HOURS=72
JOB_LOCK_DURATION_MINUTES=5
ARCHIVE_RETENTION_DAYS=90
PRUNE_RETENTION_DAYS=365

# Pricing Configuration
FILAMENT_COST_PER_GRAM=0.10
RESIN_COST_PER_GRAM=0.20
MINIMUM_CHARGE=3.00